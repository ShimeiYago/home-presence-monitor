[Unit]
Description=Home Presence Monitor (Raspberry Pi motion sender)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/home-presence-monitor/services/pi
EnvironmentFile=/home/admin/home-presence-monitor/services/pi/.env
ExecStart=/home/admin/home-presence-monitor/services/pi/.venv/bin/python /home/admin/home-presence-monitor/services/pi/monitor.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
