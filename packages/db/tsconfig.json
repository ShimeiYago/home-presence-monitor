{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@home-presence-monitor/contracts/api": [
        "../../packages/contracts/api/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/config/**/*.ts",
    "../../packages/contracts/api/**/*.ts"
  ]
}
