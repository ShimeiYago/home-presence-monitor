# backend local environment variables
#
# NOTE:
# - In AWS (Lambda), these are injected via CDK `environment`.
# - Do NOT commit real secrets. This file is only a template.

# ------------------------------
# Runtime
# ------------------------------
NODE_ENV=development

# Comma-separated origins allowed for browser cookie auth (CORS).
# Example:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------
# AWS SDK (local dev)
# ------------------------------
# Optional DynamoDB Local endpoint, e.g. http://localhost:8000
DYNAMODB_ENDPOINT=http://localhost:8000
