{
  "name": "nightreign-char-selector",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*",
    "cdk"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm -w --if-present run typecheck",
    "dev:front": "npm -w services/front run dev",
    "build:front": "npm -w services/front run build",
    "shadcn:add": "npm -w services/front run shadcn:add",
    "dev:api": "npm -w services/api run dev",
    "deploy:cdk": "npm run build:front && npm -w cdk run deploy",
    "destroy:cdk": "npm -w cdk exec -- npx aws-cdk destroy"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx,json,css,md,cjs}": [
      "prettier --write"
    ]
  }
}
